# Copy to .env for local development only. Never commit real values.
# On Railway, set these as service variables instead.

# Postgres connection string (on Railway: reference the Postgres service's DATABASE_URL).
DATABASE_URL=postgres://postgres@127.0.0.1:5432/saleslab_dev

# AI coaching. Without a key, drills run as clearly labeled unscored practice.
ANTHROPIC_API_KEY=
# Optional: the Claude model used for coaching (default claude-sonnet-5-5).
# AI_MODEL=claude-sonnet-5-5
# Optional: how long one coaching request may run, in milliseconds (default 90000).
# AI_TIMEOUT_MS=90000

# Optional: the public address used in setup and reset links. On Railway the generated
# domain is used automatically; set this only for a custom domain.
# APP_BASE_URL=https://saleslab.example.com

# Optional: the owner account created on first start (default fred.cohen@omnizant.com).
# OWNER_EMAIL=fred.cohen@omnizant.com
# OWNER_NAME=Fred Cohen
