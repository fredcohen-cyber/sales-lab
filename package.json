{
  "name": "sales-lab",
  "version": "1.0.0",
  "private": true,
  "description": "Sales Lab: practice, coaching, and reporting for the Omnizant and Ravenly sales team.",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "vite build --config client/vite.config.js",
    "start": "node server/index.js",
    "dev:server": "node --env-file-if-exists=.env --watch server/index.js",
    "dev:client": "vite --config client/vite.config.js",
    "migrate": "node --env-file-if-exists=.env server/scripts/migrate.js",
    "owner-link": "node --env-file-if-exists=.env server/scripts/owner-link.js",
    "test": "node --test --test-concurrency=1 tests/unit/*.test.js tests/integration/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.js",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.js"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "react-router-dom": "^6.30.6",
    "remark-gfm": "^4.0.1",
    "vite": "^6.4.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.56"
  }
}
